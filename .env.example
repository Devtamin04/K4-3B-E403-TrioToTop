# Required for a live evaluator. There is no implicit provider fallback.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
EVALUATOR_MODEL=

# Ollama Cloud does not currently guarantee the format field. JSON Schema is
# always placed in the prompt and validated locally. Enable only where supported.
OLLAMA_USE_FORMAT=false

# Optional bounded-call settings.
EVALUATOR_MAX_ATTEMPTS=2
EVALUATOR_TIMEOUT_SECONDS=30

# For deterministic local/API testing instead of the real evaluator, explicitly use:
# EVALUATOR_BACKEND=fixture
# EVALUATOR_FIXTURE_PATH=tests/fixtures/evaluator_cases.yaml

# Optional OpenAI provider (requires installing the `openai` extra):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
